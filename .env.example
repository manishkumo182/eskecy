# Copy to .env and fill in real values before deploying.
# Never commit the real .env file.

# --- Database ---
DB_NAME=eskecy
DB_USER=eskecy
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
TABLE_PREFIX=wp_

# --- WordPress container ---
HTTP_PORT=8080
WORDPRESS_DEBUG=0

# --- First-time `wp core install` (see README Docker section) ---
SITE_URL=http://your-vps-ip-or-domain
SITE_TITLE="Eskecy"
ADMIN_USER=admin
ADMIN_PASSWORD=changeme_admin
ADMIN_EMAIL=admin@example.com
